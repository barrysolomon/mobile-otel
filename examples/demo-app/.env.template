# Dash0 Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# Dash0 Region (choose one):
# US: https://ingress.dash0.com:4317
# EU: https://ingress.eu-west-1.aws.dash0.com:4317
DASH0_ENDPOINT=https://ingress.dash0.com:4317

# Your Dash0 Auth Token (from dash0.com dashboard)
DASH0_AUTH_TOKEN=your_token_here

# Dataset/Tenant ID (optional, for multi-tenant setups)
DASH0_DATASET=mobile-production
