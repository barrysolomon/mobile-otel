# Local Configuration Template
# Copy this file to local.properties and fill in your values
# DO NOT commit local.properties to git!

## Android SDK (required for all builds)
sdk.dir=/Users/YOUR_USERNAME/Library/Android/sdk

## Dash0 Configuration (required for release builds)
# Choose your region endpoint:
dash0.endpoint=https://ingress.dash0.com:4317
# For EU: dash0.endpoint=https://ingress.eu-west-1.aws.dash0.com:4317

# Your Dash0 auth token (get from dash0.com dashboard)
dash0.authToken=YOUR_DASH0_TOKEN_HERE

# Dataset/Tenant ID (for multi-tenant setups)
dash0.dataset=mobile-production
