<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OpenTelemetry Android Demo"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnScenarioA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scenario A: UI Freeze"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnScenarioB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scenario B: Crash"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnScenarioC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scenario C: Network Error"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnForceFlush"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Force Flush All Events"
        android:layout_marginTop="24dp" />

</LinearLayout>
