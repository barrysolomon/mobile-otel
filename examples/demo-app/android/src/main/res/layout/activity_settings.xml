<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_variant">

    <!-- Toolbar — matches ConfigActivity style -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_dark"
        app:titleTextColor="@color/text_on_primary"
        app:subtitleTextColor="@color/text_on_primary"
        app:title="Telemetry"
        app:subtitle="Collection &amp; Triggers"
        app:navigationIconTint="@color/text_on_primary" />

    <!-- Tagline strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Data Collection \u00b7 Device Metrics \u00b7 Export Triggers"
            android:textColor="@color/text_on_primary"
            android:textSize="11sp"
            android:alpha="0.85" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ─── DATA COLLECTION ─────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/primary" android:paddingHorizontal="16dp" android:paddingVertical="10dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DATA COLLECTION" android:textColor="@color/text_on_primary" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/checkboxCollectLogs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Collect Logs"
                            android:checked="true"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Application log events (errors, warnings, info)"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:paddingStart="48dp"
                            android:paddingEnd="0dp"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/checkboxCollectTraces"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Collect Traces"
                            android:checked="true"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Distributed tracing spans for request flows"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:paddingStart="48dp"
                            android:paddingEnd="0dp"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/checkboxCollectMetrics"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Collect Metrics"
                            android:checked="true"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Counters, histograms, and gauges"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:paddingStart="48dp"
                            android:paddingEnd="0dp"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/checkboxCollectDeviceMetrics"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Collect Device Metrics"
                            android:checked="true" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Device health signals (memory, battery, CPU, network)"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:paddingStart="48dp"
                            android:paddingEnd="0dp" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── DEVICE METRIC CATEGORIES ────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/primary" android:paddingHorizontal="16dp" android:paddingVertical="10dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DEVICE METRICS" android:textColor="@color/text_on_primary" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Select which device metrics to capture on triggers"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:textStyle="italic"
                            android:layout_marginBottom="12dp" />

                        <!-- Row 1: Memory / Battery -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/checkboxMetricMemory"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Memory"
                                android:textSize="13sp"
                                android:checked="true"
                                android:layout_marginBottom="8dp" />
                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/checkboxMetricBattery"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Battery"
                                android:textSize="13sp"
                                android:checked="true"
                                android:layout_marginBottom="8dp" />
                        </LinearLayout>

                        <!-- Row 2: CPU / Network -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/checkboxMetricCpu"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="CPU"
                                android:textSize="13sp"
                                android:checked="true"
                                android:layout_marginBottom="8dp" />
                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/checkboxMetricNetwork"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Network"
                                android:textSize="13sp"
                                android:checked="true"
                                android:layout_marginBottom="8dp" />
                        </LinearLayout>

                        <!-- Row 3: Storage / Display -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/checkboxMetricStorage"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Storage"
                                android:textSize="13sp"
                                android:checked="true"
                                android:layout_marginBottom="8dp" />
                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/checkboxMetricDisplay"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Display"
                                android:textSize="13sp"
                                android:checked="true"
                                android:layout_marginBottom="8dp" />
                        </LinearLayout>

                        <!-- Row 4: System / App -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/checkboxMetricSystem"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="System"
                                android:textSize="13sp"
                                android:checked="true"
                                android:layout_marginBottom="8dp" />
                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/checkboxMetricApp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="App"
                                android:textSize="13sp"
                                android:checked="true"
                                android:layout_marginBottom="8dp" />
                        </LinearLayout>

                        <!-- Row 5: Thermal / Location (privacy-sensitive, off by default) -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/checkboxMetricThermal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Thermal"
                                android:textSize="13sp"
                                android:checked="false" />
                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/checkboxMetricLocation"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Location"
                                android:textSize="13sp"
                                android:checked="false" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── EXPORT TRIGGERS ─────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/warning" android:paddingHorizontal="16dp" android:paddingVertical="10dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EXPORT TRIGGERS" android:textColor="@color/text_on_primary" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Events that automatically trigger telemetry export"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:textStyle="italic"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/checkboxUiFreeze"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="UI Freeze Detection"
                            android:checked="true"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Flush telemetry when UI freeze (>2s) is detected"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:paddingStart="48dp"
                            android:paddingEnd="0dp"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/checkboxCrash"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Crash Recovery"
                            android:checked="true"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Send buffered telemetry on app restart after crash"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:paddingStart="48dp"
                            android:paddingEnd="0dp"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/checkboxNetworkError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Network Error Escalation"
                            android:checked="true"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Flush when HTTP 5xx errors occur"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:paddingStart="48dp"
                            android:paddingEnd="0dp"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/checkboxLowMemory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Low Memory Detection"
                            android:checked="true"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Flush telemetry when low memory condition is detected"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:paddingStart="48dp"
                            android:paddingEnd="0dp" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── ACTIONS ─────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClose"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Close"
                    android:layout_marginEnd="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetDefaults"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reset"
                    android:layout_marginEnd="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="Save &amp; Apply"
                    app:backgroundTint="@color/primary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Changes take effect immediately without app restart"
                android:textSize="11sp"
                android:textStyle="italic"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
