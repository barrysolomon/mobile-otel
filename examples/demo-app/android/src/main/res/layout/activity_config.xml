<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OpenTelemetry Configuration"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Service Configuration -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Service Identity"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Service Name"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/editServiceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., my-mobile-app"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Service Version"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/editServiceVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 1.0.0"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <!-- Collector Configuration -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Collector"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Protocol"
            android:textSize="12sp"
            android:textColor="#666666" />

        <RadioGroup
            android:id="@+id/radioGroupProtocol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/radioGrpc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="gRPC (port 4317)"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioHttp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HTTP (path /v1/signal)" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Collector Endpoint"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/editCollectorEndpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., https://ingress.us-west-2.aws.dash0.com:4317"
            android:inputType="textUri"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="gRPC: Use :4317 port\nHTTP: Use /v1/logs path"
            android:textSize="10sp"
            android:textColor="#999999"
            android:textStyle="italic"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Authorization Token (Bearer)"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/editAuthToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., auth_fI0GuunaYYbw8u0n0iyFAC4Wt2FMf0jh"
            android:inputType="textPassword"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dataset / Tenant ID (optional)"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/editDataset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., pi5-k3s"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <!-- Buffer Configuration -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buffering"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RAM Buffer Size (events)"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/editRamBufferSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 5000"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disk Buffer Size (MB)"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/editDiskBufferMb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 50"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disk Buffer TTL (hours)"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/editDiskBufferTtl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 24"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <!-- Export Configuration -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export Mode"
            android:textSize="12sp"
            android:textColor="#666666" />

        <RadioGroup
            android:id="@+id/radioGroupExportMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <RadioButton android:id="@+id/radioConditional" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Conditional" />
            <RadioButton android:id="@+id/radioContinuous" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Continuous" />
            <RadioButton android:id="@+id/radioHybrid" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Hybrid" />
        </RadioGroup>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conditional = on trigger only · Continuous = scheduled · Hybrid = both"
            android:textSize="11sp" android:textStyle="italic" android:textColor="#888888"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trace Export Interval (seconds)"
            android:textSize="12sp"
            android:textColor="#666666" />
        <EditText
            android:id="@+id/editTraceExportInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 30"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Metric Export Interval (seconds)"
            android:textSize="12sp"
            android:textColor="#666666" />
        <EditText
            android:id="@+id/editMetricExportInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 60"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export Timeout (seconds)"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/editExportTimeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 30"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Max Export Retries"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/editMaxRetries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 3"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <!-- Advanced Configuration -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advanced"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkboxAttachContext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Attach Context Attributes (geo/device)"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Build Channel"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/editBuildChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., debug, beta, prod"
            android:inputType="text"
            android:layout_marginBottom="24dp" />

        <!-- Trace Sampling -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trace Sampling"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sampling Rate"
                android:textSize="12sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/tvSamplingRateValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderSamplingRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Takes effect immediately — no restart needed."
            android:textSize="11sp"
            android:textStyle="italic"
            android:textColor="#888888"
            android:layout_marginBottom="16dp" />

        <!-- Prediction Interval -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Prediction Cycle Interval"
                android:textSize="12sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/tvPredictionIntervalValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30s"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderPredictionInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="10"
            android:valueTo="120"
            android:stepSize="10"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How often the SDK checks crash/network-loss risk. Lower = more responsive, higher = less battery drain. Requires restart."
            android:textSize="11sp"
            android:textStyle="italic"
            android:textColor="#888888"
            android:layout_marginBottom="24dp" />

        <!-- Session Configuration -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Session"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkboxSessionEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable session tracking"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Session Inactivity Timeout (minutes)"
            android:textSize="12sp"
            android:textColor="#666666" />
        <EditText
            android:id="@+id/editSessionTimeoutMinutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 15"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkboxFlushOnSessionEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Flush telemetry on session end / logout"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkboxPersistSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Persist session across app restarts"
            android:checked="true"
            android:layout_marginBottom="24dp" />

        <!-- Vitals Configuration -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vitals"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkboxVitalsEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable vitals monitoring"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkboxDetectJank"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detect jank / dropped frames"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkboxMonitorThermal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monitor thermal state"
            android:checked="false"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ANR Risk Threshold (ms)"
            android:textSize="12sp"
            android:textColor="#666666" />
        <EditText
            android:id="@+id/editAnrThresholdMs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 3000"
            android:inputType="number"
            android:layout_marginBottom="24dp" />

        <!-- Network Configuration -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Network"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkboxScrubUrls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scrub query parameters from URLs"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkboxScrubHeaders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scrub sensitive request headers"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HTTP Error Threshold (status code)"
            android:textSize="12sp"
            android:textColor="#666666" />
        <EditText
            android:id="@+id/editHttpErrorThreshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 400"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Min Request Duration to Trace (ms, 0 = all)"
            android:textSize="12sp"
            android:textColor="#666666" />
        <EditText
            android:id="@+id/editMinRequestDurationMs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 0"
            android:inputType="number"
            android:layout_marginBottom="24dp" />

        <!-- Error Configuration -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Error Handling"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkboxCaptureUncaughtExceptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capture uncaught exceptions"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkboxCaptureCoroutineExceptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capture coroutine exceptions"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkboxScrubStackTraces"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scrub PII from stack traces"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkboxFlushOnError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Flush buffer immediately on error"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Error Rate Limit (per minute)"
            android:textSize="12sp"
            android:textColor="#666666" />
        <EditText
            android:id="@+id/editErrorRateLimit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 10"
            android:inputType="number"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Error Deduplication Window (minutes)"
            android:textSize="12sp"
            android:textColor="#666666" />
        <EditText
            android:id="@+id/editErrorDedupeWindowMinutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g., 5"
            android:inputType="number"
            android:layout_marginBottom="24dp" />

        <!-- What to Capture -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What to Capture"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />
        <CheckBox
            android:id="@+id/checkboxCaptureLifecycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="App Lifecycle (start, foreground, background)" />
        <CheckBox
            android:id="@+id/checkboxCaptureScreens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Screen Views" />
        <CheckBox
            android:id="@+id/checkboxCaptureTaps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Taps" />
        <CheckBox
            android:id="@+id/checkboxCaptureLongPress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Long Press" />
        <CheckBox
            android:id="@+id/checkboxCaptureSwipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Swipe Gestures" />
        <CheckBox
            android:id="@+id/checkboxCaptureScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scroll (RecyclerView)" />
        <CheckBox
            android:id="@+id/checkboxCaptureTextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Text Input (field edits)" />
        <CheckBox
            android:id="@+id/checkboxCaptureBackPress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back Button Press" />
        <CheckBox
            android:id="@+id/checkboxCaptureFragments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Fragment Transitions" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕ Close"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnResetDefaults"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset to Defaults"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Note: Changes require app restart to take effect"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="#666666"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
