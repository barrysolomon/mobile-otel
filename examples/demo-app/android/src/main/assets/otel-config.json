{
  "serviceName": "otel-mobile-demo",
  "serviceVersion": "1.0.0",
  "collectorEndpoint": "http://10.0.2.2:4317",
  "exportMode": "CONDITIONAL",
  "traceExportIntervalSeconds": 30,
  "metricExportIntervalSeconds": 60,
  "ramBufferSize": 5000,
  "diskBufferMb": 50,
  "diskBufferTtlHours": 24,
  "exportTimeoutSeconds": 30,
  "configPollIntervalSeconds": 300,
  "maxExportRetries": 3,
  "attachContextAttributes": false,
  "buildChannel": "debug",
  "headers": null,
  "telemetrySettings": {
    "dataCollection": {
      "logs": true,
      "traces": true,
      "metrics": true,
      "deviceMetrics": true
    },
    "deviceMetricCategories": {
      "memory": true,
      "battery": true,
      "cpu": true,
      "network": true,
      "storage": true,
      "thermal": false,
      "display": true,
      "system": true,
      "app": true,
      "location": false
    },
    "triggers": {
      "uiFreeze": true,
      "crash": true,
      "networkError": true,
      "lowMemory": true
    }
  },
  "workflows": [
    {
      "id": "ui-freeze-detector",
      "name": "UI Freeze Detection",
      "enabled": true,
      "description": "Detects UI freezes > 2s and flushes last 2 minutes",
      "trigger": {
        "all": [
          {
            "event": "ui.freeze",
            "where": [
              {
                "attr": "duration_ms",
                "op": ">",
                "value": 2000
              }
            ]
          }
        ]
      },
      "actions": [
        {
          "type": "flush_window",
          "minutes": 2,
          "scope": "session"
        },
        {
          "type": "annotate_trigger",
          "trigger_id": "ui-freeze-detector",
          "reason": "UI freeze detected - collecting context"
        }
      ]
    },
    {
      "id": "http-error-5xx",
      "name": "HTTP 5xx Error Handler",
      "enabled": true,
      "description": "Captures server errors and flushes last 5 minutes",
      "trigger": {
        "all": [
          {
            "event": "http.error",
            "where": [
              {
                "attr": "http.status_code",
                "op": ">=",
                "value": 500
              }
            ]
          }
        ]
      },
      "actions": [
        {
          "type": "flush_window",
          "minutes": 5,
          "scope": "session"
        },
        {
          "type": "set_sampling",
          "rate": 100,
          "duration_minutes": 10
        }
      ]
    },
    {
      "id": "low-memory-alert",
      "name": "Low Memory Detection",
      "enabled": true,
      "description": "Detects low memory conditions and captures state",
      "trigger": {
        "all": [
          {
            "event": "device.memory.low",
            "where": [
              {
                "attr": "available_mb",
                "op": "<",
                "value": 100
              }
            ]
          }
        ]
      },
      "actions": [
        {
          "type": "flush_window",
          "minutes": 2,
          "scope": "device"
        },
        {
          "type": "annotate_trigger",
          "trigger_id": "low-memory-alert",
          "reason": "Low memory condition detected"
        }
      ]
    },
    {
      "id": "crash-recovery",
      "name": "Crash Recovery Handler",
      "enabled": true,
      "description": "Flushes pre-crash telemetry after app restart",
      "trigger": {
        "all": [
          {
            "event": "app.crash_recovery",
            "where": []
          }
        ]
      },
      "actions": [
        {
          "type": "flush_window",
          "minutes": 10,
          "scope": "device"
        }
      ]
    }
  ],
  "limits": {
    "diskMb": 50,
    "ramEvents": 5000,
    "retentionHours": 24
  }
}
