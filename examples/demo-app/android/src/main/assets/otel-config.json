{
  "serviceName": "otel-mobile-demo",
  "serviceVersion": "1.0.0-dev",
  "collectorEndpoint": "https://ingress.us-west-2.aws.dash0.com:4317",
  "exportMode": "CONDITIONAL",
  "headers": {
    "Authorization": "Bearer auth_fI0GuunaYYbw8u0n0iyFAC4Wt2FMf0jh",
    "Dash0-Dataset": "otel-mobile"
  },

  "traceExportIntervalSeconds": 30,
  "metricExportIntervalSeconds": 60,
  "ramBufferSize": 5000,
  "diskBufferMb": 50,
  "diskBufferTtlHours": 24,
  "exportTimeoutSeconds": 30,
  "configPollIntervalSeconds": 300,
  "maxExportRetries": 3,
  "attachContextAttributes": false,
  "buildChannel": "debug",

  "sessionConfig": {
    "enabled": true,
    "inactivityTimeoutMs": 900000,
    "flushOnTermination": true,
    "persistSession": true
  },

  "breadcrumbConfig": {
    "enabled": true,
    "maxSize": 50,
    "captureNavigation": true,
    "captureUserInput": true,
    "captureNetwork": true,
    "captureErrors": true,
    "scrubElementIds": true,
    "scrubNetworkUrls": true,
    "allowedScreens": []
  },

  "vitalsConfig": {
    "enabled": true,
    "measureAppStart": true,
    "measureTtid": true,
    "detectJank": true,
    "trackInputLatency": true,
    "monitorAnrRisk": true,
    "monitorMemoryPressure": true,
    "monitorThermalState": false,
    "jankThresholdMs": 16.0,
    "severeJankThresholdMs": 100.0,
    "inputLatencyThresholdMs": 50.0,
    "anrRiskThresholdMs": 3000,
    "coldStartThresholdMs": 5000,
    "warmStartThresholdMs": 2000,
    "ttidThresholdMs": 3000,
    "memoryPressureCriticalMb": 50,
    "samplingRate": 1.0,
    "reportingIntervalMs": 60000
  },

  "networkConfig": {
    "enabled": true,
    "propagateTraceContext": true,
    "captureRequestHeaders": ["Content-Type"],
    "captureResponseHeaders": ["Content-Type"],
    "captureRequestBody": false,
    "captureResponseBody": false,
    "maxBodyCaptureBytes": 1024,
    "scrubUrls": true,
    "scrubHeaders": true,
    "detectNetworkType": true,
    "reportNetworkSpeed": false,
    "bucketSizes": true,
    "minDurationMs": 0,
    "errorStatusThreshold": 400,
    "allowedHosts": [],
    "blockedHosts": []
  },

  "errorConfig": {
    "enabled": true,
    "captureUncaughtExceptions": true,
    "captureCoroutineExceptions": true,
    "captureRxJavaExceptions": false,
    "deduplicateWindowMs": 300000,
    "rateLimit": 10,
    "maxStackTraceDepth": 50,
    "scrubStackTraces": true,
    "attachBreadcrumbs": true,
    "attachVitals": true,
    "proguardMappingFile": null,
    "filterExceptions": [],
    "captureExceptionMessages": true,
    "captureCauses": true,
    "flushOnError": true
  },

  "telemetrySettings": {
    "dataCollection": {
      "logs": true,
      "traces": true,
      "metrics": true,
      "deviceMetrics": true
    },
    "deviceMetricCategories": {
      "memory": true,
      "battery": true,
      "cpu": true,
      "network": true,
      "storage": true,
      "thermal": false,
      "display": true,
      "system": true,
      "app": true,
      "location": false
    },
    "triggers": {
      "uiFreeze": true,
      "crash": true,
      "networkError": true,
      "lowMemory": true
    }
  },
  "workflows": [
    {
      "id": "ui-freeze-detector",
      "name": "UI Freeze Detection",
      "enabled": true,
      "description": "Detects UI freezes > 2s and flushes last 2 minutes",
      "trigger": {
        "all": [
          {
            "event": "ui.freeze",
            "where": [
              {
                "attr": "duration_ms",
                "op": ">",
                "value": 2000
              }
            ]
          }
        ]
      },
      "actions": [
        {
          "type": "flush_window",
          "minutes": 2,
          "scope": "session"
        },
        {
          "type": "annotate_trigger",
          "trigger_id": "ui-freeze-detector",
          "reason": "UI freeze detected - collecting context"
        }
      ]
    },
    {
      "id": "http-error-5xx",
      "name": "HTTP 5xx Error Handler",
      "enabled": true,
      "description": "Captures server errors and flushes last 5 minutes",
      "trigger": {
        "all": [
          {
            "event": "http.error",
            "where": [
              {
                "attr": "http.status_code",
                "op": ">=",
                "value": 500
              }
            ]
          }
        ]
      },
      "actions": [
        {
          "type": "flush_window",
          "minutes": 5,
          "scope": "session"
        },
        {
          "type": "set_sampling",
          "rate": 100,
          "duration_minutes": 10
        }
      ]
    },
    {
      "id": "low-memory-alert",
      "name": "Low Memory Detection",
      "enabled": true,
      "description": "Detects low memory conditions and captures state",
      "trigger": {
        "all": [
          {
            "event": "device.memory.low",
            "where": [
              {
                "attr": "available_mb",
                "op": "<",
                "value": 100
              }
            ]
          }
        ]
      },
      "actions": [
        {
          "type": "flush_window",
          "minutes": 2,
          "scope": "device"
        },
        {
          "type": "annotate_trigger",
          "trigger_id": "low-memory-alert",
          "reason": "Low memory condition detected"
        }
      ]
    },
    {
      "id": "crash-recovery",
      "name": "Crash Recovery Handler",
      "enabled": true,
      "description": "Flushes pre-crash telemetry after app restart",
      "trigger": {
        "all": [
          {
            "event": "app.crash_recovery",
            "where": []
          }
        ]
      },
      "actions": [
        {
          "type": "flush_window",
          "minutes": 10,
          "scope": "device"
        }
      ]
    },
    {
      "id": "app-foreground",
      "name": "App Foreground Handler",
      "enabled": true,
      "description": "Flushes buffered events when app returns to foreground from background",
      "trigger": {
        "all": [
          {
            "event": "app.foreground",
            "where": []
          }
        ]
      },
      "actions": [
        {
          "type": "flush_window",
          "minutes": 5,
          "scope": "session"
        },
        {
          "type": "annotate_trigger",
          "trigger_id": "app-foreground",
          "reason": "App returned to foreground - capturing background session data"
        }
      ]
    }
  ],
  "limits": {
    "diskMb": 50,
    "ramEvents": 5000,
    "retentionHours": 24
  }
}
