{
  "serviceName": "otel-mobile-demo",
  "serviceVersion": "1.1.0-20260306",
  "collectorEndpoint": "https://YOUR_COLLECTOR_ENDPOINT:4317",
  "exportMode": "CONTINUOUS",
  "headers": {
    "Authorization": "Bearer YOUR_AUTH_TOKEN",
    "Dash0-Dataset": "YOUR_DATASET_NAME"
  },

  "traceExportIntervalSeconds": 10,
  "metricExportIntervalSeconds": 30,
  "ramBufferSize": 1000,
  "diskBufferMb": 20,
  "diskBufferTtlHours": 24,
  "exportTimeoutSeconds": 30,
  "configPollIntervalSeconds": 300,
  "maxExportRetries": 3,
  "attachContextAttributes": true,
  "buildChannel": "debug",
  "samplingRate": 1.0,

  "telemetrySettings": {
    "dataCollection": {
      "logs": true,
      "traces": true,
      "metrics": true,
      "deviceMetrics": true
    },
    "deviceMetricCategories": {
      "memory": true,
      "battery": true,
      "cpu": true,
      "network": true,
      "storage": true,
      "thermal": true,
      "display": true,
      "system": true,
      "app": true,
      "location": false
    },
    "triggers": {
      "uiFreeze": true,
      "crash": true,
      "networkError": true,
      "lowMemory": true
    }
  },
  "exportPolicies": [
    {
      "id": "ui-freeze-detector",
      "name": "UI Freeze Detection",
      "enabled": true,
      "description": "Detects UI freezes > 2s and flushes last 2 minutes",
      "trigger": {
        "all": [
          {
            "event": "ui.freeze",
            "where": [
              {
                "attr": "duration_ms",
                "op": ">",
                "value": 2000
              }
            ]
          }
        ]
      },
      "actions": [
        {
          "type": "flush_window",
          "minutes": 2,
          "scope": "session"
        }
      ]
    },
    {
      "id": "crash-recovery",
      "name": "Crash Recovery Handler",
      "enabled": true,
      "description": "Flushes pre-crash telemetry after app restart",
      "trigger": {
        "all": [
          {
            "event": "app.crash_recovery",
            "where": []
          }
        ]
      },
      "actions": [
        {
          "type": "flush_window",
          "minutes": 10,
          "scope": "device"
        }
      ]
    },
    {
      "id": "app-foreground",
      "name": "App Foreground Handler",
      "enabled": true,
      "description": "Flushes buffered events when app returns to foreground from background",
      "trigger": {
        "all": [
          {
            "event": "app.foreground",
            "where": []
          }
        ]
      },
      "actions": [
        {
          "type": "flush_window",
          "minutes": 5,
          "scope": "session"
        },
        {
          "type": "annotate_trigger",
          "trigger_id": "app-foreground",
          "reason": "App returned to foreground - capturing background session data"
        }
      ]
    },
    {
      "id": "http-error-flush",
      "name": "HTTP Error Handler",
      "enabled": true,
      "description": "Flushes surrounding context on HTTP errors (>= 400), excluding 404s",
      "trigger": {
        "all": [
          {
            "event": "http.error",
            "where": [
              {
                "attr": "http.status_code",
                "op": ">=",
                "value": 400
              },
              {
                "attr": "http.status_code",
                "op": "!=",
                "value": 404
              }
            ]
          }
        ]
      },
      "actions": [
        {
          "type": "flush_window",
          "minutes": 2,
          "scope": "session"
        }
      ]
    }
  ]
}
