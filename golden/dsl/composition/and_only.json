{
  "name": "and logical composition",
  "description": "multi-condition policy with operator=and; default operator when unspecified is also and",
  "policies": [
    {
      "id": "and-policy",
      "enabled": true,
      "match": {
        "operator": "and",
        "attributes": {
          "event.name": { "equals": "http.error" },
          "http.status_code": { "gte": 500 }
        }
      },
      "actions": { "flushWindowMinutes": 2 }
    }
  ],
  "cases": [
    {
      "name": "and: both conditions present matches",
      "attributes": { "event.name": "http.error", "http.status_code": "503" },
      "expectedMatch": "and-policy"
    },
    {
      "name": "and: only one condition matches no-match",
      "attributes": { "event.name": "http.error", "http.status_code": "200" },
      "expectedMatch": null
    },
    {
      "name": "and: neither condition no-match",
      "attributes": { "event.name": "ui.tap" },
      "expectedMatch": null
    }
  ]
}
